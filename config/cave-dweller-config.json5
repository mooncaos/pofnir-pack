{
	// POFNIR — jaula do terror. Lei 3 do CLAUDE.md: spawn natural DESLIGADO.
	// O Morador so entra em cena pela Marca da Presenca (kubejs/server_scripts/marca_presenca.js),
	// que o invoca por comando. Comando ignora esta chance; ela rege apenas o spawn ambiente.

	"GIVE_DARKNESS": true,
	"DISAPPEAR": true,

	// ALTERADO: padrao do mod = 0.005. Zero = nunca spawna sozinho.
	"SPAWN_CHANCE_PER_TICK": 0.0,

	"RESET_CALM_MIN": 300,
	"RESET_CALM_MAX": 600,
	"RESET_CALM_COOLDOWN": 1200,
	"RESET_CALM_COOLDOWN_CHANCE": 0.4,
	"RESET_NOISE_MIN": 240,
	"RESET_NOISE_MAX": 360,
	"SPAWN_HEIGHT": 40,
	"ALLOW_SURFACE_SPAWN": false,
	"SKY_LIGHT_LEVEL": 8,
	"BLOCK_LIGHT_LEVEL": 15,
	"SPOTTING_RANGE": 60,
	"TIME_UNTIL_LEAVE": 300,
	"TIME_UNTIL_LEAVE_CHASE": 30,
	"CAN_CLIMB": true,
	"ALLOW_RIDING": false,
	"TARGET_INVISIBLE": true,

	// Stats intocados (Lei 4: balanceamento e da diretoria). Valores = defaults do mod.
	"MAX_HEALTH": 60.0,
	"ATTACK_DAMAGE": 6.0,
	"ATTACK_SPEED": 0.35,
	"MOVEMENT_SPEED": 0.5
}
